# ── Stage 1: Build ─────────────────────────────────────────────────────────
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /workspace

# Cache deps separately from source
COPY go.work go.work.sum ./
COPY citual/go.mod citual/go.sum ./citual/
COPY spur-identity/go.mod spur-identity/go.sum ./spur-identity/
COPY spur-messaging/go.mod spur-messaging/go.sum ./spur-messaging/
COPY spur-storage/go.mod ./spur-storage/
COPY spur-web/go.mod spur-web/go.sum ./spur-web/

WORKDIR /workspace/citual
RUN go mod download

WORKDIR /workspace
COPY citual ./citual
COPY spur-identity ./spur-identity
COPY spur-messaging ./spur-messaging
COPY spur-storage ./spur-storage

WORKDIR /workspace/citual
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -X main.version=$(git describe --tags --always 2>/dev/null || echo dev)" \
    -o /app/spur ./cmd/main.go

# ── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /app/spur .

# Key directory — RSA private key mounted here at runtime
RUN mkdir -p /app/keys && chmod 700 /app/keys

EXPOSE 8080 9091

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["/app/spur"]
