# ─── Core ────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Spur
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://spur:changeme@postgres:5432/spur?sslmode=disable
POSTGRES_DB=spur
POSTGRES_USER=spur
POSTGRES_PASSWORD=changeme

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── UI ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_THEME=spur
CITUAL_CONTACT_LEAD_FORM_KEY=

# ─── GRPC ───────────────────────────────────────────────────
# gRPC server listen address
GRPC_ADDR=:9090
# Enable gRPC server reflection
GRPC_REFLECTION=true
# Enable gRPC-Gateway (REST bridge)
GRPC_GATEWAY=false

# ─── WEBSOCKET ───────────────────────────────────────────────────
# WebSocket endpoint path
WS_PATH=/ws
# Keepalive ping interval
WS_PING_INTERVAL=30s
# Max WebSocket message size (bytes)
WS_MAX_MSG_SIZE=65536

# ─── SSE ───────────────────────────────────────────────────
# SSE keepalive interval
SSE_KEEPALIVE=15s

# ─── HLS ───────────────────────────────────────────────────
# HLS segment server address
HLS_ADDR=:8888
# Directory for HLS segments
HLS_STORAGE_PATH=./data/hls
# Segment duration in seconds
HLS_SEGMENT_DUR=4
# CDN URL prefix (optional, leave empty for local)
HLS_CDN_URL=

# ─── RTMP ───────────────────────────────────────────────────
# RTMP ingest address (standard port)
RTMP_ADDR=:1935

# ─── TEMPORAL ───────────────────────────────────────────────────
# Temporal server address
TEMPORAL_HOST=
# Temporal namespace
TEMPORAL_NAMESPACE=default
# Run worker in-process (false = separate worker binary)
TEMPORAL_WORKER=true

# ─── QUEUE ───────────────────────────────────────────────────
# Redis Streams key prefix
QUEUE_PREFIX=spur
# Max messages to retain per stream
QUEUE_MAX_LEN=10000

# ─── Observability ──────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── identity ──────────────────────────────────────────────────
IDENTITY_JWT_SECRET=
IDENTITY_ISSUER=
FOSITE_GLOBAL_SECRET=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# IDENTITY_ACCESS_TTL=
# IDENTITY_REFRESH_TTL=
# IDENTITY_OTP_EXPIRY=
# IDENTITY_COOKIE_NAME=
# IDENTITY_COOKIE_SECURE=

API_KEY_HEADER=X-Bootstrap-Key
API_KEY_VALUE=citual-bootstrap-2026

# ── messaging ──────────────────────────────────────────────────
MESSAGING_ENCRYPTION_KEY=
MESSAGING_WEBHOOK_BASE_URL=
MESSAGING_REDIS_URL=
# MESSAGING_DEFAULT_RATE_LIMIT=
# MESSAGING_WORKER_COUNT=
# MESSAGING_EMAIL_PROVIDER=
# MESSAGING_EMAIL_FROM_ADDRESS=
# MESSAGING_EMAIL_FROM_NAME=
# MESSAGING_EMAIL_TRACK_OPENS=
# MESSAGING_EMAIL_TRACK_CLICKS=
# MESSAGING_SMS_PROVIDER=
# MESSAGING_SMS_SENDER_ID=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# POSTMARK_SERVER_TOKEN=
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_META_APP_ID=
# WHATSAPP_META_APP_SECRET=
# WHATSAPP_GRAPH_API_VERSION=v23.0
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
